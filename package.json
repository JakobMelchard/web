{
  "name": "@jakobmelchard/web",
  "version": "0.1.1",
  "description": "Shared PWA shell: tokens, base CSS, manifest, service worker, install page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakobMelchard/web.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "python3 tokens/build_tokens.py && cp src/* dist/",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.js\"",
    "check": "tsc && npm run build && test -z \"$(git status --porcelain dist)\"",
    "e2e": "node --test \"test/e2e/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jakobmelchard/config": "github:JakobMelchard/.config#v1.0.0",
    "@types/node": "^22",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "playwright-core": "1.63.0",
    "typescript": "^5"
  }
}
