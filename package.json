{
  "name": "@jakobmelchard/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens-dark.css": "./dist/tokens-dark.css",
    "./tokens.swift": "./dist/tokens.swift",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "python3 tokens/build_tokens.py && cp src/* dist/",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.js\"",
    "check": "tsc && npm run build && test -z \"$(git status --porcelain dist)\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jakobmelchard/config": "github:JakobMelchard/.config#v1.0.0",
    "@types/node": "^22",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "globals": "^17.12.0",
    "typescript": "^5"
  }
}
